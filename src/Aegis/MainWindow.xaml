<Window x:Class="Aegis.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aegis">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid Padding="48" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="8">
      <TextBlock Text="Aegis" FontSize="32" FontWeight="SemiBold" />
      <TextBlock Text="A calm, focused workspace for the work ahead." Opacity="0.72" FontSize="16" />
    </StackPanel>
    <Border Grid.Row="1" Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Welcome to Aegis" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Your workspace is ready." Opacity="0.72" />
        <TextBlock Text="Ask Aegis" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
        <TextBox x:Name="QuestionTextBox" PlaceholderText="Type an investigation question" MinHeight="40" />
        <Button x:Name="InvestigateButton" Content="Investigate" Click="InvestigateButton_Click" HorizontalAlignment="Left" MinWidth="120" />
        <ProgressRing x:Name="BusyIndicator" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left" />
        <TextBlock x:Name="StatusTextBlock" Opacity="0.72" TextWrapping="Wrap" />
        <TextBlock x:Name="AnswerTextBlock" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
