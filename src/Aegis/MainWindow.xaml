<Window x:Class="Aegis.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aegis" Activated="MainWindow_Activated">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid Padding="48" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="260" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="8">
      <TextBlock Text="Aegis" FontSize="32" FontWeight="SemiBold" />
      <TextBlock Text="A calm, focused workspace for the work ahead." Opacity="0.72" FontSize="16" />
    </StackPanel>
    <Border Grid.Row="1" Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Welcome to Aegis" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Your workspace is ready." Opacity="0.72" />
        <TextBlock Text="Ask Aegis" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
        <TextBox x:Name="QuestionTextBox" PlaceholderText="Type an investigation question" MinHeight="40" />
        <Button x:Name="InvestigateButton" Content="Investigate" Click="InvestigateButton_Click" HorizontalAlignment="Left" MinWidth="120" />
        <ProgressRing x:Name="BusyIndicator" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left" />
        <TextBlock x:Name="StatusTextBlock" Opacity="0.72" TextWrapping="Wrap" />
        <TextBlock x:Name="AnswerTextBlock" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*" />
        <ColumnDefinition Width="1.4*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="History" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="Refresh" Click="RefreshHistoryButton_Click" />
        </StackPanel>
        <ListView x:Name="HistoryListView" DisplayMemberPath="DisplayText" SelectionChanged="HistoryListView_SelectionChanged" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock Text="Investigation detail" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="HistoryDetailTextBlock" TextWrapping="Wrap" Opacity="0.82" />
        <ListView x:Name="ObservationListView" DisplayMemberPath="DisplayText" SelectionChanged="ObservationListView_SelectionChanged" MaxHeight="90" />
        <TextBlock x:Name="ObservationDetailTextBlock" TextWrapping="Wrap" Opacity="0.72" />
        <Button x:Name="CreateBaselineButton" Content="Create baseline from selected observation" Click="CreateBaselineButton_Click" IsEnabled="False" HorizontalAlignment="Left" />
        <TextBlock x:Name="BaselineStatusTextBlock" TextWrapping="Wrap" Opacity="0.72" />
        <TextBlock Text="Baselines" FontWeight="SemiBold" />
        <ListView x:Name="BaselineListView" DisplayMemberPath="DisplayText" SelectionChanged="BaselineListView_SelectionChanged" MaxHeight="70" />
        <TextBlock x:Name="BaselineDetailTextBlock" TextWrapping="Wrap" Opacity="0.72" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
