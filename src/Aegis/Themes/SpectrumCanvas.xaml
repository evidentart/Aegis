<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <LinearGradientBrush x:Key="SpectrumCanvasBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F4EEFF" Offset="0" />
        <GradientStop Color="#F7F7FF" Offset="0.55" />
        <GradientStop Color="#EAF4FF" Offset="1" />
      </LinearGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <LinearGradientBrush x:Key="SpectrumCanvasBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#211A38" Offset="0" />
        <GradientStop Color="#111426" Offset="0.6" />
        <GradientStop Color="#142039" Offset="1" />
      </LinearGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="SpectrumCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
