<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <ImageBrush x:Key="NavigationViewDefaultPaneBackground" ImageSource="ms-appx:///Assets/SpectrumSidebar.png" Stretch="UniformToFill" AlignmentY="Bottom" />
      <ImageBrush x:Key="NavigationViewExpandedPaneBackground" ImageSource="ms-appx:///Assets/SpectrumSidebar.png" Stretch="UniformToFill" AlignmentY="Bottom" />
      <SolidColorBrush x:Key="SpectrumNavigationTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SpectrumNavigationSubtitleBrush" Color="#F0E8FF" />
      <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NavigationViewItemBackground" Color="#88101958" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#321389" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#321389" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#321389" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#55FFFFFF" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FAF7FF" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#DED5FA" />
      <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#7138EF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SpectrumNavigationTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SpectrumNavigationSubtitleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="NavigationViewItemBackground" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Thickness x:Key="NavigationViewItemMargin">0,4,0,4</Thickness>
</ResourceDictionary>
